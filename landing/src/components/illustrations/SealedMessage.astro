---
/** Every message is sealed, padded to a fixed size class, and signed. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 200 120"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <g class="text-ink-muted" stroke="currentColor">
    <rect x="16" y="20" width="168" height="80" rx="6" stroke-dasharray="6 5"></rect>
    <path d="M40 88h8M56 88h8M72 88h8M88 88h8M104 88h8"></path>
  </g>
  <g class="text-ink" stroke="currentColor">
    <rect x="32" y="34" width="86" height="40" rx="4"></rect>
    <path d="M44 48h30M44 58h48M84 48h22"></path>
    <path d="M132 50v-6a10 10 0 0 1 20 0v6"></path>
    <rect x="128" y="50" width="28" height="22" rx="4"></rect>
  </g>
  <g class="text-accent" stroke="currentColor">
    <circle cx="164" cy="76" r="14"></circle>
    <path d="M158 76l4 5 8-10"></path>
  </g>
</svg>
