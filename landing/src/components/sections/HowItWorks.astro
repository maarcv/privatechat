---
import { getHome } from '../../lib/content';
import type { Locale } from '../../lib/i18n';
import { anchorOf } from '../../lib/sections';
import ChannelKey from '../illustrations/ChannelKey.astro';
import Invitation from '../illustrations/Invitation.astro';
import SealedMessage from '../illustrations/SealedMessage.astro';
import VerifyPeople from '../illustrations/VerifyPeople.astro';
import Inline from '../ui/Inline.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/** One drawing per step, in the order of the four steps of `landing/CONTENT.md` §3. */
const ILLUSTRATIONS = [ChannelKey, Invitation, SealedMessage, VerifyPeople];

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { howItWorks } = await getHome(locale);

const steps = ILLUSTRATIONS.map((Illustration, index) => {
  const step = howItWorks.steps[index];
  if (step === undefined) {
    throw new Error('landing: "How it works" needs one step per illustration');
  }
  return { ...step, Illustration, number: index + 1 };
});
---

<Section id={anchorOf('howItWorks')}>
  <SectionHeading title={howItWorks.title} lead={howItWorks.lead} />

  <ol class="mt-12 grid gap-10 sm:grid-cols-2">
    {
      steps.map(({ number, title, body, Illustration }) => (
        <li class="flex flex-col gap-4">
          <Illustration class="h-28 w-full max-w-xs text-ink" />
          <div>
            <h3 class="flex items-baseline gap-2 font-semibold">
              <span class="font-mono text-sm text-accent">{number}</span>
              {title}
            </h3>
            <Inline text={body} class="mt-1.5 leading-relaxed text-ink-muted" />
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-12 border-t border-line pt-6">
    <h3 class="text-sm font-semibold tracking-wide uppercase">{howItWorks.also.title}</h3>
    <ul class="mt-3 grid gap-2 text-ink-muted">
      {howItWorks.also.items.map((item) => <Inline as="li" text={item} class="leading-relaxed" />)}
    </ul>
  </div>
</Section>
