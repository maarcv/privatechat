---
import { getHome } from '../../lib/content';
import type { Locale } from '../../lib/i18n';
import { hrefOf } from '../../lib/links';
import { anchorOf } from '../../lib/sections';
import Button from '../ui/Button.astro';
import Inline from '../ui/Inline.astro';
import Section from '../ui/Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { idea } = await getHome(locale);
---

<Section id={anchorOf('idea')} tone="hero">
  <div class="max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{idea.title}</h1>
    <Inline text={idea.lead} class="mt-6 text-lg leading-relaxed text-ink-muted sm:text-xl" />
  </div>

  <div class="mt-10 flex flex-wrap gap-3">
    {
      idea.actions.map((item, index) => (
        <Button href={hrefOf(item, locale)} variant={index === 0 ? 'primary' : 'secondary'}>
          {item.label}
        </Button>
      ))
    }
  </div>

  <ul class="mt-16 grid gap-8 border-t border-line pt-10 sm:grid-cols-3">
    {
      idea.points.map((point) => (
        <li>
          <h2 class="text-base font-semibold">{point.title}</h2>
          <Inline text={point.body} class="mt-2 leading-relaxed text-ink-muted" />
        </li>
      ))
    }
  </ul>
</Section>
