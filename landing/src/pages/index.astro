---
import { DEFAULT_LOCALE, LOCALE_NAMES, localePath } from '../lib/i18n';

/**
 * Every page of the site lives under a language prefix (`landing/CONTENT.md` "Site
 * structure"), so the root is nothing but a way in. It redirects without JavaScript and
 * still works if the redirect is ignored.
 */
const target = localePath(DEFAULT_LOCALE);
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <title>privatechat</title>
  </head>
  <body>
    <a href={target}>privatechat ({LOCALE_NAMES[DEFAULT_LOCALE]})</a>
  </body>
</html>
